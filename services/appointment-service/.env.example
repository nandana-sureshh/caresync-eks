# CareSync Appointment Service — Environment Variables
# Copy to .env for local development outside Docker

PORT=4004
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/appointmentdb

JWT_SECRET=change_this_to_a_strong_secret
AUTH_SERVICE_URL=http://localhost:4001
PATIENT_SERVICE_URL=http://localhost:4002
DOCTOR_SERVICE_URL=http://localhost:4003
